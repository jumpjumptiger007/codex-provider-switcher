{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Provider Switcher",
  "version": "0.1.1",
  "identifier": "tech.yliu.codex-provider-switcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Codex Provider Switcher",
        "width": 760,
        "height": 800,
        "minWidth": 360,
        "minHeight": 420
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Utility",
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
