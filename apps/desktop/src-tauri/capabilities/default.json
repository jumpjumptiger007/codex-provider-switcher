{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Allow the main window to use CPS provider, credential, model, and switching commands.",
  "windows": ["main"],
  "permissions": [
    "allow-get-providers",
    "allow-get-status",
    "allow-get-credential-status",
    "allow-save-credential",
    "allow-get-models",
    "allow-switch-model"
  ]
}
